###############################################################################
# Pet Store — environment configuration
#
# Copy to .env and fill in. This file must never contain a real secret.
# Keep .env outside the web root and readable only by the application user.
###############################################################################

APP_NAME="Pet Store"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

# Store everything in UTC; the display timezone is a presentation concern.
APP_TIMEZONE=UTC
APP_LOCALE=en

# Customer-facing defaults. These can be overridden in Admin → Brand.
STORE_NAME="Pet Store"
STORE_TAGLINE="Considered supplies for dogs and cats"
STORE_DISPLAY_TIMEZONE=America/New_York
STORE_DISPLAY_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=warning

###############################################################################
# Database
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=petstore
DB_USERNAME=
DB_PASSWORD=

###############################################################################
# Sessions, cache and queues
#
# All database-backed so no Redis is required on shared hosting. On a VPS
# you can switch SESSION_DRIVER, CACHE_STORE and QUEUE_CONNECTION to redis
# without changing any application code.
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

###############################################################################
# Mail
#
# Transactional email must work before launch: receipts, dispatch notices
# and guest tracking links all depend on it.
###############################################################################
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="orders@example.com"
MAIL_FROM_NAME="${STORE_NAME}"

###############################################################################
# CJdropshipping
#
# IMPORTANT: the endpoint paths in config/petstore.php were written from
# published API 2.0 conventions and have NOT been verified against the live
# API from the build environment. Run `php artisan cj:verify` against your
# real account and work through docs/integration-notes.md before switching
# the integration to live mode in Admin → Integrations.
#
# The account email and API key are entered in the admin panel, where they
# are stored encrypted. They are deliberately NOT read from here.
###############################################################################
CJ_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1/
CJ_RATE_LIMIT_PER_SECOND=1
CJ_TIMEOUT_SECONDS=30
CJ_CONNECT_TIMEOUT_SECONDS=10
CJ_RETRY_TIMES=2
CJ_PAGE_SIZE=50
STOCK_FRESHNESS_HOURS=12

###############################################################################
# PayPal
#
# Only the client ID is ever exposed to the browser. The secret and webhook
# ID stay server side.
#
# Before enabling live mode you must confirm with PayPal that this account
# is a BUSINESS account permitted to receive commercial Checkout payments
# in USD. A personal account cannot. Sandbox success proves nothing about
# this. Record the confirmation in Admin → Payment methods.
###############################################################################
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

###############################################################################
# Paystack (optional alternative)
#
# Do NOT add USD to this gateway's supported currencies until Paystack has
# confirmed in writing that this account can charge and settle in USD. If
# the account is NGN-only, leave the method disabled — the store will not
# silently charge a different currency than the one shown.
###############################################################################
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

###############################################################################
# Operational
###############################################################################
# Shipping quotes are cached briefly and re-fetched at checkout.
SHIPPING_QUOTE_TTL_MINUTES=20
SHIPPING_ESTIMATOR_TTL_MINUTES=30

# Guest order tracking links.
GUEST_ORDER_TOKEN_DAYS=90

# Require two-factor authentication for every staff account.
# Turn this on once everyone has enrolled an authenticator app.
ADMIN_REQUIRE_MFA=false

# Must stay false in production. Guards against seeding demo catalogue data
# into a live shop.
DEMO_SEEDING_ENABLED=false

# Shows the "demonstration mode" banner while any integration is not live.
DEMO_BANNER=true

###############################################################################
# Build
###############################################################################
VITE_APP_NAME="${APP_NAME}"
